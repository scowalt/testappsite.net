{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "testappsite-free-tools",
  "account_id": "a2dd27ff56de48a73e384881d22e60e2",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "testappsite.net/free-tools", "zone_name": "testappsite.net" },
    { "pattern": "testappsite.net/free-tools/*", "zone_name": "testappsite.net" },
    { "pattern": "www.testappsite.net/free-tools", "zone_name": "testappsite.net" },
    { "pattern": "www.testappsite.net/free-tools/*", "zone_name": "testappsite.net" }
  ]
}
